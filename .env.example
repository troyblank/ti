# Port the HTTP server listens on.
PORT=3000

# Interface to bind to. Use 0.0.0.0 inside Docker so the port can be published.
HOST=0.0.0.0

# Comma-separated list of browser origins allowed to call this API (CORS).
# Leave empty to disallow all cross-origin browser requests.
# Example: http://localhost:5173,https://ti.example.com
CORS_ORIGIN=http://localhost:5173

# Base URL of the local Ollama server.
# docker-compose.yml overrides this to http://ollama:11434 inside the container;
# this value is for running `yarn dev` on the host against Ollama in Docker.
OLLAMA_URL=http://localhost:11434

# Loopback port docker-compose.yml publishes Ollama on. Must match OLLAMA_URL.
OLLAMA_PORT=11434

# Ollama model TI uses to answer questions. Must be pulled before use — see README.
# 3B-class models are the sweet spot for a CPU-only NAS with 8–16GB RAM.
OLLAMA_MODEL=llama3.2:3b

# How long TI waits for Ollama's reply before giving up with a 504, in milliseconds.
# Keep it under 300000: Node's fetch abandons a silent connection after 5 minutes anyway.
OLLAMA_TIMEOUT_MS=240000
