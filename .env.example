# Port the HTTP server listens on.
PORT=3000

# Interface to bind to. Use 0.0.0.0 inside Docker so the port can be published.
HOST=0.0.0.0

# Comma-separated list of browser origins allowed to call this API (CORS).
# Leave empty to disallow all cross-origin browser requests.
# Example: http://localhost:5173,https://ti.example.com
CORS_ORIGIN=http://localhost:5173
